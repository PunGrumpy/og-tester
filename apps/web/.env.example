# Databuddy analytics client id (public). https://www.databuddy.cc
NEXT_PUBLIC_DATABUDDY_CLIENT_ID=your-databuddy-client-id

# Unkey API keys for MCP endpoint auth. https://www.unkey.com
# The root key must start with "unkey_".
UNKEY_API_KEY=your-unkey-api-key
UNKEY_ROOT_KEY=unkey_your-root-key

# Upstash Redis for the shared rate limit and the report store. https://upstash.com
# Optional: without these, dev falls back to in-memory stores.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
